# A window too small for the layout: the project pane sits at its minimum width, and
# an overlay's text wraps inside its box.
mask /Created: [A-Z][a-z]+ (\d\d, \d{4}|\d, \d{4} ?)/ "Created: <date>"
wait Projects
frame first-screen

press l
wait /(?m)^╭.*┏/
frame items-focused

press t
wait New task for
frame task-prompt
press esc
gone New task for

press /
wait enter keep
frame filter-prompt
press esc
gone enter keep

press enter
wait Tasks 1/3
frame reader
press esc
gone Tasks 1/3

press q
exits
