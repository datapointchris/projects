# A window too small for the layout: the project pane sits at its minimum width, and
# an overlay's text wraps inside its box.
mask /Created: [A-Z][a-z]+ \d+, \d{4}/ "Created: <date>"
wait Projects
frame first-screen

press tab
wait /(?m)^╭.*┏/
frame items-focused

press t
wait New task for
frame task-prompt
press esc
gone New task for

press /
wait Search...
frame search-prompt
press esc
gone Search...

press enter
wait ─── Tasks (1/3) ───
frame reader
press esc
gone ─── Tasks (1/3) ───

press q
exits
