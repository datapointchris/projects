# Open an item and a project in the reader, scroll a long note, and close each.
mask /Created: [A-Z][a-z]+ \d+, \d{4}/ "Created: <date>"
mask /Project [0-9a-f]{8}/ "Project <id>"

wait Export posts from the old CMS
press tab
wait [Enter]read

press enter
wait ─── Notes ───
frame item-top
press ctrl+d
wait Conversion script
frame item-half-page-down
press G
wait Last line of the note.
frame item-bottom
press g
wait Item 1 ·
press esc
wait [Enter]read
frame closed-onto-the-list

press h
wait [a]dd project
press enter
wait ─── Description ───
frame project
press q
wait [a]dd project

press q
exits
