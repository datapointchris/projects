# Add a task from the list, then toggle one and delete one. d deletes nothing.
wait Export posts from the old CMS
press l
wait [Enter]read

press t
wait New task for "Export posts from the old CMS"
frame prompt
type Check the image links
press enter
wait ○ Check the image links
wait [1/4]
frame added-from-the-list

press j
wait /> +✓ Dump the database/
press j
wait /> +○ Convert HTML to markdown/
press space
wait [2/4]
frame task-toggled
press d
press D
wait [1/3]
gone Convert HTML to markdown
frame task-deleted

press q
exits
