# Move through projects and items: panes, rows, task rows, filters, multi-select and a
# list longer than the window.
wait Export posts from the old CMS
frame first-screen

press l
wait [Enter]read
frame items-focused

press j
wait /> +✓ Dump the database/
frame cursor-on-task

press ]
wait /> +✓ Pick a theme/
press G
wait /> +○ Point DNS at the new host/
frame cursor-on-last-item
press g
wait /> +▸ ○ Export posts from the old CMS/

press 1
wait [BLOCKED]
frame blocked-filter
press 0
gone [BLOCKED]
press 2
wait [ALL]
frame archived-filter
press 0
gone [ALL]

press h
wait [space]mark
press space
wait Selected (1)
press j
wait > Replace the kitchen faucet
press space
wait Selected (2)
frame two-projects-selected
press esc
gone Selected (2)

press G
wait > Plan the Lisbon trip
frame last-project
press l
wait [Enter]read
press ctrl+d
wait /> +○ Day 10: walk the next neighborhood/
frame long-list-half-page
press G
wait /> +○ Day 28: walk the next neighborhood/
frame long-list-bottom

press ctrl+c
exits
