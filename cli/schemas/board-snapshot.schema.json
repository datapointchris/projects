{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:projects:board-snapshot:v1",
  "title": "board-snapshot",
  "description": "`projects tui --json`: what the board shows as it opens. The project pane lists the active projects. The item pane lists the open items of the project under the cursor in the projects view, and every project's open items, grouped by project, in the items view. The dependencies view holds the dependency map and no items.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "view",
    "projects",
    "project",
    "items",
    "tree"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "The version of this document's shape. A field added keeps it, and a field reshaped or removed raises it."
    },
    "view": {
      "type": "string",
      "enum": [
        "projects",
        "items",
        "dependencies"
      ],
      "description": "The view the snapshot is of."
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project-with-item-count"
      }
    },
    "project": {
      "description": "The project under the cursor, or null with no projects and in the items view.",
      "anyOf": [
        {
          "$ref": "#/$defs/project-with-item-count"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project-item-in-project"
      },
      "description": "The rows the item pane lists, in its order. An item filed in two projects shows once under each in the items view."
    },
    "tree": {
      "description": "The dependency map in the dependencies view, as `projects items dependencies tree --json` prints it, and null in the other views. It holds the trees the map draws as it opens, which leaves out a tree with no open work.",
      "anyOf": [
        {
          "$ref": "urn:projects:dependency-tree:v1"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "project-with-item-count": {
      "type": "object",
      "description": "A project and what its items add up to. A field added is not a new version, and a field reshaped or removed is.",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "kind",
        "status",
        "status_reason",
        "closed_at",
        "position",
        "created_at",
        "item_count",
        "open_count",
        "completed_count",
        "repos"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "description": "One of the names in the project_kinds table."
        },
        "status": {
          "type": "string",
          "description": "One of the names in the project_statuses table."
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "closed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "position": {
          "type": "integer"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "item_count": {
          "type": "integer",
          "description": "Every membership, archived items included."
        },
        "open_count": {
          "type": "integer"
        },
        "completed_count": {
          "type": "integer"
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "project-item-in-project": {
      "type": "object",
      "description": "An item as one project holds it, the one listed_under names. A field added is not a new version, and a field reshaped or removed is.",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "notes",
        "repo",
        "completed",
        "completed_at",
        "archived",
        "status",
        "created_at",
        "updated_at",
        "position",
        "project_count",
        "listed_under"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "number": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The item's handle. Null only on a store whose server has not assigned one yet."
        },
        "title": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed": {
          "type": "boolean"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "archived": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "completed",
            "archived"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "position": {
          "type": "integer"
        },
        "project_count": {
          "type": "integer",
          "description": "How many projects hold the item."
        },
        "listed_under": {
          "type": "object",
          "description": "The project whose list or group the row is under.",
          "additionalProperties": false,
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
