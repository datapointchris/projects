{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:projects:item-with-tasks-and-blockers:v1",
  "title": "item-with-tasks-and-blockers",
  "description": "`projects items show --json`: one item's fields with what it depends on, then its tasks and the open items blocking it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "number",
    "title",
    "notes",
    "repo",
    "completed",
    "completed_at",
    "archived",
    "status",
    "created_at",
    "updated_at",
    "projects",
    "memberships",
    "dependency_ids",
    "depends_on",
    "tasks",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "The version of this document's shape. A field added keeps it, and a field reshaped or removed raises it."
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The item's handle. Null only on a store whose server has not assigned one yet."
    },
    "title": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "repo": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed": {
      "type": "boolean"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "archived": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "completed",
        "archived"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "memberships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/membership"
      }
    },
    "dependency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/summary"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project-item"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "kind",
        "status",
        "status_reason",
        "closed_at",
        "position",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "description": "One of the names in the project_kinds table."
        },
        "status": {
          "type": "string",
          "description": "One of the names in the project_statuses table."
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "closed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "position": {
          "type": "integer"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "position"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "position": {
          "type": "integer"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "completed",
        "archived",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "number": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The item's handle. Null only on a store whose server has not assigned one yet."
        },
        "title": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        },
        "archived": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "completed",
            "archived"
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "item_id",
        "title",
        "completed",
        "completed_at",
        "position",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "item_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "position": {
          "type": "integer"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "project-item": {
      "type": "object",
      "description": "An item with what is filed against it, as a list returns it. A field added is not a new version, and a field reshaped or removed is.",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "notes",
        "repo",
        "completed",
        "completed_at",
        "archived",
        "status",
        "created_at",
        "updated_at",
        "projects",
        "memberships",
        "dependency_ids",
        "tasks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "number": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The item's handle. Null only on a store whose server has not assigned one yet."
        },
        "title": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed": {
          "type": "boolean"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "archived": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "completed",
            "archived"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/project"
          }
        },
        "memberships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/membership"
          }
        },
        "dependency_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    }
  }
}
