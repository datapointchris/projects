{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:projects:probe:v1",
  "title": "probe",
  "type": "object",
  "description": "What /health and /ready answer. A field added is not a new version, and a field reshaped or removed is.",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "ready",
        "unavailable"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}
