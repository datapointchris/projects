{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:projects:project-item-task:v1",
  "title": "project-item-task",
  "type": "object",
  "description": "One task on an item.",
  "additionalProperties": false,
  "required": [
    "id",
    "item_id",
    "title",
    "completed",
    "completed_at",
    "position",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "item_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string"
    },
    "completed": {
      "type": "boolean"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "position": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
